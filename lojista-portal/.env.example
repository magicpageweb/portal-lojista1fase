# Copie para .env e preencha com os valores do Supabase Dashboard.
# NUNCA commite o arquivo .env — ele está no .gitignore.

# --- Público (anon / publishable) — usado no browser (prefixo VITE_) ---
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_ou_anon
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# --- Servidor (SSR / middleware TanStack Start) — mesmos valores, sem VITE_ ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_ou_anon
SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# --- Apenas local / scripts de seed (NÃO configurar na Vercel) ---
# Service role ignora RLS — use só em máquina de desenvolvimento ou CI privado.
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret
